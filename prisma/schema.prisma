generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Experience {
  id     String  @id @default(cuid())
  skills Skill[]

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  position String?
  company  String?

  startDate DateTime
  endDate   DateTime?

  @@index([projectId])
  @@index([startDate])
  @@index([endDate])
  @@index([company])
  @@index([position])
}

model Skill {
  id         String       @id @default(cuid())
  name       String       @unique
  level      Int          @default(1)
  experience Experience[]
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  url         String?
  experience  Experience[]
}

model Hobby {
  id   String @id @default(cuid())
  name String @unique
}
