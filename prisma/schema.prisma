generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Skills {
  id   String @id @default(cuid())
  name String @unique
}

model Experience {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  position  String?
  company   String?
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  url         String?
  experiences Experience[]
}
