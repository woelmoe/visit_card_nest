generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Experience {
  id     String  @id @default(cuid())
  skills Skill[]

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  employmentId String?
  employment   Employment? @relation(fields: [employmentId], references: [id], onDelete: SetNull)

  startDate DateTime
  endDate   DateTime?

  @@index([projectId])
  @@index([startDate])
  @@index([endDate])
  @@index([employmentId])
}

model Employment {
  id          String       @id @default(uuid())
  position    String
  company     String
  experiences Experience[]
}

model Skill {
  id         String       @id @default(cuid())
  name       String       @unique
  level      Int          @default(1)
  experience Experience[]
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  url         String?
  experience  Experience[]
}

model Hobby {
  id   String @id @default(cuid())
  name String @unique
}
